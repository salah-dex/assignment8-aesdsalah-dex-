#!/bin/sh

module=aesdchar
device=aesdchar
mode="664"
cd `dirname $0`
# set -e means exit on error, so if any command fails the script will stop
set -e
# Group: since distributions do it differently, look for wheel or use staff, Note: this is not a secure way to do this, but it is a simple way to get the group correct for most distributions

echo "attempting to load module ${module} and create device ${device} with mode ${mode}"

if grep -q '^staff:' /etc/group; then
    group="staff"
else
    group="wheel"
fi

if [ -e ${module}.ko ]; then
    echo "Loading local built file ${module}.ko"
    insmod ./$module.ko $* ||  echo "Failed to load module using insmod ${module}.ko" && exit 1
else
    echo "Local file ${module}.ko not found, attempting to modprobe"
    modprobe ${module} || echo "Failed to load module using modprobe ${module}" && exit 1
fi
major=$(awk "\$2==\"$module\" {print \$1}" /proc/devices)
rm -f /dev/${device}
mknod /dev/${device} c $major 0 || echo "Failed to create device /dev/${device}" && exit 1
chgrp $group /dev/${device}     || echo "Failed to change group of /dev/${device} to $group" && exit 1
chmod $mode  /dev/${device}     || echo "Failed to change mode of /dev/${device} to $mode" && exit 1
