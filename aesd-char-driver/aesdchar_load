#!/bin/sh

module=aesdchar
device=aesdchar
mode="664"
cd `dirname $0`
# set -e means exit on error, so if any command fails the script will stop
set -e
# Group: since distributions do it differently, look for wheel or use staff, Note: this is not a secure way to do this, but it is a simple way to get the group correct for most distributions

echo "attempting to load module ${module} and create device ${device} with mode ${mode}"

if grep -q '^staff:' /etc/group; then
    group="staff"
else
    group="wheel"
fi

if [ -e "./${module}.ko" ]; then
    echo "Loading local module ${module}.ko"
    if ! insmod "./${module}.ko" "$@"; then
        echo "Failed to load module using insmod"
        exit 1
    fi
else
    echo "Loading module ${module} using modprobe"
    if ! modprobe "$module"; then
        echo "Failed to load module using modprobe"
        exit 1
    fi
fi

major=$(awk -v module="$module" '$2 == module {print $1}' /proc/devices)

if [ -z "$major" ]; then
    echo "Error: module $module is not registered in /proc/devices"
    exit 1
fi

rm -f "/dev/$device"

if ! mknod "/dev/$device" c "$major" 0; then
    echo "Failed to create device node /dev/$device"
    exit 1
else
    echo "Created device node /dev/$device with major number $major"
fi
